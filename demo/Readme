************For Hybrid Approach (Manual + Auto-Generation)*****************
Use a conditional strategy (e.g., manually set ID only if it's null):

java
Copy
@Entity
public class Product {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    public void setId(Long id) {
        // Only set ID if not already set (auto-generation takes precedence)
        if (this.id == null) {
            this.id = id;
        }
    }
}
